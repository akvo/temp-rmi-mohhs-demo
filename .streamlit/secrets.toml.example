# Copy to .streamlit/secrets.toml for local dev, or paste into the Streamlit
# Community Cloud app's "Secrets" settings when deploying. This is one of
# two supported credential sources -- see .env.example for the other
# (local `streamlit run` / the standalone build scripts also accept .env).
[mis]
user = "you@example.org"
password = "yourpassword"

# Optional -- which MIS instance to talk to. Defaults to
# mis_client.DEFAULT_BASE_URL (https://mohhs.mis.akvo.org) when unset.
# base_url = "https://mohhs.mis.akvo.org"
